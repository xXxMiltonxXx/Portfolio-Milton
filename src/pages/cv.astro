---
// Hoja de vida lista para imprimir. El PDF de /Milton-Angamarca-CV.pdf se genera
// desde esta misma página con `npm run build && npm run cv`.
import { profile } from "../data/profile";

const strip = (s: string) => s.replace(/<[^>]+>/g, "");
// Frases completas hasta pasar de ~70 caracteres, para que una frase corta no deje la ficha vacía.
const brief = (s: string) => {
  let out = "";
  for (const sentence of s.split(/(?<=\.)\s/)) {
    out += (out ? " " : "") + sentence;
    if (out.length > 70) break;
  }
  return out;
};
const featured = ["Salud Metabólica", "BioGuard", "Quill ULEAM", "BridgeUleam"];
const projects = featured.map((n) => profile.projects.find((p) => p.name === n)).filter((p) => !!p);
const web = new URL(Astro.site!).host;
const linkedin = profile.links.linkedin.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const github = profile.links.github.replace(/^https?:\/\//, "");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`CV · ${profile.name}`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="bar">
      <a href="/">← Volver al portafolio</a>
      <a class="dl" href="/Milton-Angamarca-CV.pdf" download>Descargar PDF</a>
    </div>

    <main class="sheet">
      <aside class="side">
        <img class="photo" src={profile.photo} alt={profile.name} width="120" height="120" />

        <section>
          <h2>Contacto</h2>
          <ul class="plain">
            <li>{profile.location}</li>
            <li><a href={profile.links.linkedin}>{linkedin}</a></li>
            <li><a href={profile.links.github}>{github}</a></li>
            <li><a href={Astro.site!.toString()}>{web}</a></li>
          </ul>
        </section>

        <section>
          <h2>Habilidades</h2>
          {profile.stack.map((g) => (
            <div class="skill">
              <h3>{g.group}</h3>
              <p>{g.items.join(", ")}</p>
            </div>
          ))}
        </section>

        <section>
          <h2>Idiomas</h2>
          <ul class="plain">
            {profile.languages.map((l) => <li><strong>{l.name}</strong> · {l.level}</li>)}
          </ul>
        </section>

        <section>
          <h2>Formación</h2>
          <div class="skill">
            <h3>Universidad Laica Eloy Alfaro de Manabí (ULEAM)</h3>
            <p>Manta, Ecuador</p>
          </div>
          {profile.certifications.map((c) => (
            <div class="skill">
              <h3>{c.title}</h3>
              <p>{[c.issuer, c.date].filter(Boolean).join(" · ")}</p>
            </div>
          ))}
        </section>
      </aside>

      <div class="main">
        <header class="head">
          <h1>{profile.name}</h1>
          <p class="role">{profile.role}</p>
        </header>

        <section>
          <h2>Perfil</h2>
          <p>{strip(profile.about[1])}</p>
          <p>{strip(profile.about[2])}</p>
        </section>

        <section>
          <h2>Experiencia</h2>
          {profile.experience.map((e) => (
            <article class="job">
              <div class="row">
                <h3>{e.title}</h3>
                <span class="when">{e.period}</span>
              </div>
              <p class="org">{e.org}</p>
              <ul>
                {e.points.map((pt) => <li>{pt}</li>)}
              </ul>
              <p class="tags">{e.tags.join(" · ")}</p>
            </article>
          ))}
        </section>

        <section>
          <h2>Proyectos destacados</h2>
          {projects.map((p) => (
            <article class="job">
              <div class="row">
                <h3>{p!.name}</h3>
                <span class="when">{p!.year}</span>
              </div>
              <p>{brief(p!.summary)}</p>
              <p class="tags">{p!.tags.slice(0, 7).join(" · ")}</p>
            </article>
          ))}
        </section>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1d1d1f;
    --ink-2: #515154;
    --ink-3: #86868b;
    --line: #d2d2d7;
    --accent: #0066cc;
    --side: #f5f5f7;
  }
  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: #e8e8ed;
    color: var(--ink);
    font: 400 9.3pt/1.4 "Inter", -apple-system, "Segoe UI", system-ui, sans-serif;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  a {
    color: inherit;
    text-decoration: none;
  }

  .bar {
    max-width: 210mm;
    margin: 0 auto;
    padding: 18px 16px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }
  .bar a {
    color: var(--accent);
  }
  .bar .dl {
    background: var(--accent);
    color: #fff;
    padding: 8px 16px;
    border-radius: 980px;
  }

  .sheet {
    width: 210mm;
    max-width: 100%;
    margin: 16px auto 40px;
    background: #fff;
    display: grid;
    grid-template-columns: 62mm 1fr;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
  }
  .side {
    background: var(--side);
    padding: 8mm 6mm;
    display: flex;
    flex-direction: column;
    gap: 4.5mm;
  }
  .main {
    padding: 10mm 10mm 10mm 9mm;
    display: flex;
    flex-direction: column;
    gap: 5mm;
    min-width: 0;
  }
  .photo {
    width: 25mm;
    height: 25mm;
    border-radius: 50%;
    object-fit: cover;
    align-self: center;
  }

  h1 {
    margin: 0;
    font-size: 24pt;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .role {
    margin: 4px 0 0;
    color: var(--ink-2);
    font-size: 11pt;
  }
  h2 {
    margin: 0 0 3mm;
    font-size: 8pt;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  h3 {
    margin: 0;
    font-size: 10pt;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0 0 2mm;
  }
  .main section > p {
    color: var(--ink-2);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.2mm;
    font-size: 8.5pt;
    overflow-wrap: anywhere;
  }
  .skill {
    margin-bottom: 1.8mm;
    break-inside: avoid;
  }
  .skill h3 {
    font-size: 8pt;
    line-height: 1.3;
    margin-bottom: 0.5mm;
  }
  .skill p {
    margin: 0;
    font-size: 8pt;
    color: var(--ink-2);
    line-height: 1.35;
  }

  .job {
    padding-bottom: 3mm;
  }
  .job h3,
  .job .org {
    break-after: avoid;
  }
  .job li {
    break-inside: avoid;
  }
  .job + .job {
    padding-top: 3mm;
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 8mm;
    align-items: baseline;
  }
  .when {
    flex: none;
    color: var(--ink-3);
    font-size: 8.5pt;
  }
  .org {
    color: var(--ink-2);
    margin-bottom: 1.5mm;
  }
  .job ul {
    margin: 0 0 2mm;
    padding-left: 4.5mm;
    color: var(--ink-2);
  }
  .job li {
    margin-bottom: 0.8mm;
  }
  .tags {
    color: var(--ink-3);
    font-size: 8.5pt;
    margin: 0;
  }

  @page {
    size: A4;
    margin: 0;
  }
  @media print {
    /* La columna lateral cubre toda la hoja en cada página. */
    body {
      background: linear-gradient(to right, var(--side) 62mm, #fff 62mm);
    }
    .bar {
      display: none;
    }
    .sheet {
      margin: 0;
      width: 210mm;
      box-shadow: none;
    }
    .sheet {
      background: transparent;
    }
    .side {
      background: transparent;
    }
  }

  @media (max-width: 760px) {
    .sheet {
      grid-template-columns: 1fr;
      width: 100%;
      margin: 12px 0 0;
    }
    .main {
      order: -1;
      padding: 20px;
    }
    .side {
      padding: 20px;
    }
  }
</style>
