---
import { profile, type Category } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const filters: { id: "todos" | Category; label: string }[] = [
  { id: "todos", label: "Todos" },
  { id: "ia", label: "IA" },
  { id: "web", label: "Web" },
  { id: "movil", label: "Móvil" },
  { id: "backend", label: "Backend" },
  { id: "devops", label: "DevOps" },
];
const catLabel: Record<Category, string> = { ia: "IA", web: "Web", movil: "Móvil", backend: "Backend", devops: "DevOps" };
---

<section id="proyectos" class="band alt">
  <div class="container wide">
    <div class="section-head reveal">
      <span class="eyebrow">Proyectos</span>
      <h2 class="headline">Lo que he lanzado. <span class="soft">Desde agentes de IA hasta apps de salud.</span></h2>
    </div>

    <div class="segmented reveal" role="group" aria-label="Filtrar proyectos">
      {filters.map((f, i) => (
        <button type="button" class:list={["seg", { active: i === 0 }]} data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
          {f.label}
        </button>
      ))}
    </div>

    <ul class="grid">
      {profile.projects.map((p) => (
        <li class:list={["tile project reveal", { featured: p.featured }]} data-cats={p.categories.join(" ")}>
          <p class="meta">
            <span>{p.categories.map((c) => catLabel[c]).join(" · ")}</span>
            <span>{p.year}</span>
          </p>
          <h3>{p.name}</h3>
          <p class="summary">{p.summary}</p>
          <ul class="hl">
            {p.highlights.map((h) => <li>{h}</li>)}
          </ul>
          <div class="stack">
            <p class="stack-label">Tecnologías</p>
            <ul class="tech">
              {p.tags.map((t) => (
                <li><TechIcon name={t} size={16} /><span>{t}</span></li>
              ))}
            </ul>
          </div>
          <div class="links">
            {p.live && <a class="link" href={p.live} target="_blank" rel="noopener">Ver en vivo</a>}
            {p.repo && <a class="link" href={p.repo} target="_blank" rel="noopener">Ver código</a>}
            {!p.repo && p.private && <span class="private">Repositorio privado</span>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const segs = document.querySelectorAll<HTMLButtonElement>("#proyectos .seg");
  const cards = document.querySelectorAll<HTMLElement>("#proyectos .project");
  segs.forEach((seg) =>
    seg.addEventListener("click", () => {
      const f = seg.dataset.filter!;
      segs.forEach((s) => {
        s.classList.toggle("active", s === seg);
        s.setAttribute("aria-pressed", String(s === seg));
      });
      cards.forEach((card) => {
        card.hidden = !(f === "todos" || card.dataset.cats!.split(" ").includes(f));
      });
    }),
  );
</script>

<style>
  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 3px;
    border-radius: 980px;
    background: var(--tile-alt);
    margin-bottom: 40px;
    max-width: 100%;
  }
  :global(.band.alt) .segmented {
    background: color-mix(in srgb, var(--fg) 7%, transparent);
  }
  .seg {
    border: none;
    background: transparent;
    color: var(--fg);
    font: 400 0.9rem var(--font);
    padding: 7px 18px;
    border-radius: 980px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .seg.active {
    background: var(--tile);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    font-weight: 500;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .project.featured {
      grid-column: span 3;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr auto;
      column-gap: 56px;
    }
    .featured > * {
      grid-column: 1;
    }
    .featured .hl,
    .featured .stack {
      grid-column: 2;
    }
    .featured .hl {
      grid-row: 1 / 3;
      align-self: start;
      margin-top: 0;
    }
    .featured .stack {
      grid-row: 3 / 6;
      align-self: start;
    }
    .featured .links {
      grid-row: 5;
    }
    .featured h3 {
      font-size: 2.4rem;
    }
  }
  .project {
    padding: clamp(26px, 3.4vw, 40px);
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .project:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 10px;
    font-size: 0.85rem;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: 1.6rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 700;
  }
  .summary {
    margin: 12px 0 0;
    color: var(--fg-2);
  }
  .hl {
    margin: 16px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
    font-size: 0.95rem;
    color: var(--fg-2);
  }
  .stack {
    margin-top: 22px;
  }
  .stack-label {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .tech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tech li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 980px;
    background: var(--tile-alt);
    font-size: 0.8rem;
    color: var(--fg);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: auto;
    padding-top: 24px;
  }
  .private {
    color: var(--fg-3);
    font-size: 0.95rem;
  }
</style>
