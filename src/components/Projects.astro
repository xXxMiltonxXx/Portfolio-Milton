---
import { profile, type Category } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const filters: { id: "todos" | Category; label: string }[] = [
  { id: "todos", label: "Todos" },
  { id: "ia", label: "IA" },
  { id: "web", label: "Web" },
  { id: "movil", label: "Móvil" },
  { id: "backend", label: "Backend" },
  { id: "devops", label: "DevOps" },
];
const catLabel: Record<Category, string> = { ia: "IA", web: "Web", movil: "Móvil", backend: "Backend", devops: "DevOps" };
// Tarjetas flotantes del encabezado, como las ilustraciones de la invitación de Valentina.
const collage = [
  { src: "/proyectos/bioguard.webp", cls: "f-bio" },
  { src: "/proyectos/salud-metabolica.webp", cls: "f-salud" },
  { src: "/proyectos/valentina.webp", cls: "f-vale" },
];
// Collage en escritorio: retícula de 12 columnas. Cada proyecto tiene su lugar
// [columna inicial, columnas, fila inicial, filas]; los tres bloques encajan sin huecos.
const collageLayout: Record<string, [number, number, number, number]> = {
  // Bloque 1 (filas 1 a 8)
  "IssA": [1, 7, 1, 5],
  "Motor de IA de IssA": [8, 5, 1, 3],
  "BioGuard": [8, 5, 4, 5],
  "Hacknarok 2024": [1, 4, 6, 3],
  "Invitación Valentina": [5, 3, 6, 3],
  // Bloque 2 (filas 9 a 16)
  "Quill ULEAM": [1, 3, 9, 5],
  "Sistema Center · ZGames": [4, 6, 9, 4],
  "Tastyfood": [10, 3, 9, 3],
  "BridgeUleam": [10, 3, 12, 5],
  "Sistema escolar Brighton": [4, 3, 13, 4],
  "ULEAM Community Hub": [7, 3, 13, 4],
  "Laboratorio IoT": [1, 3, 14, 3],
  // Bloque 3 (filas 17 a 21)
  "Coactiva": [1, 3, 17, 5],
  "ArtConnect API": [4, 3, 17, 5],
  "Salud Metabólica": [7, 6, 17, 3],
  "Backups automatizados": [7, 6, 20, 2],
};
const order = Object.keys(collageLayout);
// En tablet estas ocupan el ancho completo.
const wide = new Set(["IssA", "Salud Metabólica"]);
const projects = profile.projects
  .map((p, i) => ({
    ...p,
    id: `pd-${i}`,
    kind: p.categories.map((c) => catLabel[c]).join(" · "),
    url: p.live ?? p.repo,
    slot: collageLayout[p.name],
  }))
  .sort((a, b) => (order.indexOf(a.name) + 1 || 99) - (order.indexOf(b.name) + 1 || 99));
const count = (id: "todos" | Category) =>
  id === "todos" ? profile.projects.length : profile.projects.filter((p) => p.categories.includes(id)).length;
---

<section id="proyectos" class="band alt">
  <div class="container wide">
    <div class="head">
      <div class="head-copy">
        <div class="section-head reveal">
          <span class="eyebrow">Proyectos</span>
          <h2 class="headline">Todo lo que he construido. <span class="soft">Toca uno para ver el detalle.</span></h2>
        </div>
        <div class="segmented reveal" role="group" aria-label="Filtrar proyectos">
          {filters.map((f, i) => (
            <button type="button" class:list={["seg", { active: i === 0 }]} data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
              {f.label}<span class="n">{count(f.id)}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="collage" aria-hidden="true">
        {collage.map((c) => (
          <figure class:list={["float", c.cls]}>
            <img src={c.src} alt="" width="600" height="400" loading="lazy" />
          </figure>
        ))}
      </div>
    </div>

    <ul class="grid">
      {projects.map((p) => (
        <li
          class:list={["card reveal", { wide: wide.has(p.name) }]}
          data-cats={p.categories.join(" ")}
          style={p.slot ? `--gc:${p.slot[0]} / span ${p.slot[1]};--gr:${p.slot[2]} / span ${p.slot[3]}` : undefined}
        >
          <button type="button" class="card-btn" data-open={p.id} aria-haspopup="dialog" aria-label={`Ver detalle de ${p.name}`}>
            <span class="media">
              {p.image ? (
                <img src={p.image} alt="" width="1600" height="914" loading="lazy" class:list={{ portrait: p.portrait }} style={p.focus ? `object-position:${p.focus}` : undefined} />
              ) : (
                <span class="cover" aria-hidden="true">
                  <span class="cover-tech">
                    {p.tags.slice(0, 4).map((t) => <span class="cover-chip"><TechIcon name={t} size={26} /></span>)}
                  </span>
                </span>
              )}
            </span>
            <span class="overlay">
              <span class="kind">{p.kind}</span>
              <span class="name">{p.name}</span>
            </span>
            <span class="arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M7 17 17 7M8 7h9v9" /></svg>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  {projects.map((p) => (
    <dialog class="pd" id={p.id} aria-labelledby={`${p.id}-t`}>
      <div class="pd-scroll">
        <header class="pd-bar">
          <p class="pd-crumb"><strong>{p.name}</strong> <span>de {profile.name}</span></p>
          <div class="pd-actions">
            {p.url && (
              <a class="icon-btn" href={p.url} target="_blank" rel="noopener" aria-label="Abrir el proyecto">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
              </a>
            )}
            <button type="button" class="icon-btn" data-close aria-label="Cerrar">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
        </header>

        <div class="pd-hero">
          <span class="pd-badge"><small>{p.kind}</small><strong>{p.year}</strong></span>
          <h3 class="pd-title" id={`${p.id}-t`}>{p.name}</h3>
          <p class="pd-by">{profile.name} · {profile.location}</p>
        </div>

        <div class="pd-media">
          {p.image ? (
            <div class:list={["pd-shot", { portrait: p.portrait }]}>
              {p.portrait && <img class="backdrop" src={p.image} alt="" width="765" height="1024" loading="lazy" aria-hidden="true" />}
              <img class="shot" src={p.image} alt={`Captura de ${p.name}`} width="1600" height="914" loading="lazy" />
            </div>
          ) : (
            <div class="pd-shot cover big" aria-hidden="true">
              <span class="cover-name">{p.name}</span>
              <span class="cover-tech">{p.tags.slice(0, 6).map((t) => <TechIcon name={t} size={30} />)}</span>
            </div>
          )}
        </div>
      </div>

      <div class="pd-pop" data-panel="resumen" hidden>
        <h4>Resumen</h4>
        <p>{p.summary}</p>
      </div>
      <div class="pd-pop" data-panel="tecnologias" hidden>
        <h4>Tecnologías</h4>
        <ul class="chips">
          {p.tags.map((t) => <li><TechIcon name={t} size={16} /><span>{t}</span></li>)}
        </ul>
      </div>
      <div class="pd-pop" data-panel="detalles" hidden>
        <h4>Detalles</h4>
        <ul class="points">{p.highlights.map((h) => <li>{h}</li>)}</ul>
        <p class="pd-repo">
          {p.repo ? <a class="link" href={p.repo} target="_blank" rel="noopener">Ver código</a> : p.private ? "Repositorio privado" : ""}
        </p>
      </div>

      <nav class="pd-tools" aria-label={`Información de ${p.name}`}>
        <span class="pd-mark" aria-hidden="true">M.</span>
        <div class="pd-tabs" role="group">
          <button type="button" data-tab="resumen" aria-pressed="false">Resumen</button>
          <button type="button" data-tab="tecnologias" aria-pressed="false">Tecnologías</button>
          <button type="button" data-tab="detalles" aria-pressed="false">Detalles</button>
        </div>
        {p.url ? (
          <a class="pd-visit" href={p.url} target="_blank" rel="noopener">{p.live ? "Visitar sitio" : "Ver código"}</a>
        ) : (
          <span class="pd-visit off">Privado</span>
        )}
      </nav>
    </dialog>
  ))}
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Filtros
  const segs = document.querySelectorAll<HTMLButtonElement>("#proyectos .seg");
  const cards = document.querySelectorAll<HTMLElement>("#proyectos .card");
  segs.forEach((seg) =>
    seg.addEventListener("click", () => {
      const f = seg.dataset.filter!;
      segs.forEach((s) => {
        s.classList.toggle("active", s === seg);
        s.setAttribute("aria-pressed", String(s === seg));
      });
      cards.forEach((card) => {
        card.hidden = !(f === "todos" || card.dataset.cats!.split(" ").includes(f));
      });
      document.querySelector("#proyectos .grid")?.classList.toggle("filtered", f !== "todos");
      // Las tarjetas que aún no habían aparecido con el scroll seguían
      // invisibles: las mostramos y recalculamos los disparadores, porque
      // la altura de la sección cambió.
      const shown = [...cards].filter((c) => !c.hidden);
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        gsap.set(shown, { clearProps: "transform,opacity" });
        ScrollTrigger.refresh();
      } else
        gsap.fromTo(
          shown,
          { y: 24, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.6,
            ease: "expo.out",
            stagger: 0.05,
            overwrite: true,
            clearProps: "transform,opacity",
            onComplete: () => ScrollTrigger.refresh(),
          },
        );
    }),
  );

  // Ficha de detalle
  const root = document.documentElement;
  const close = (d: HTMLDialogElement) => {
    d.classList.add("closing");
    setTimeout(() => {
      d.classList.remove("closing");
      d.close();
    }, 220);
  };
  document.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const d = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      if (!d) return;
      d.querySelector(".pd-scroll")?.scrollTo(0, 0);
      d.showModal();
      root.classList.add("pd-open");
    }),
  );
  document.querySelectorAll<HTMLDialogElement>("dialog.pd").forEach((d) => {
    d.addEventListener("close", () => {
      root.classList.remove("pd-open");
      d.querySelectorAll<HTMLElement>(".pd-pop").forEach((p) => (p.hidden = true));
      d.querySelectorAll("[data-tab]").forEach((t) => t.setAttribute("aria-pressed", "false"));
    });
    d.addEventListener("cancel", (e) => {
      e.preventDefault();
      close(d);
    });
    d.querySelector("[data-close]")?.addEventListener("click", () => close(d));
    d.addEventListener("click", (e) => {
      if (e.target === d) close(d);
    });
    const tabs = d.querySelectorAll<HTMLButtonElement>("[data-tab]");
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        const on = tab.getAttribute("aria-pressed") !== "true";
        tabs.forEach((t) => t.setAttribute("aria-pressed", String(t === tab && on)));
        d.querySelectorAll<HTMLElement>(".pd-pop").forEach((p) => (p.hidden = !(on && p.dataset.panel === tab.dataset.tab)));
      }),
    );
  });
</script>

<style>
  /* ---------- Encabezado ---------- */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .head .section-head {
    margin-bottom: 0;
  }
  .head-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
    min-width: 0;
    flex: 1 1 520px;
  }
  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 3px;
    border-radius: 980px;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    max-width: 100%;
  }
  .seg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    background: transparent;
    color: var(--fg);
    font: 400 0.9rem var(--font);
    padding: 7px 16px;
    border-radius: 980px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .seg .n {
    font-size: 0.75rem;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .seg.active {
    background: var(--tile);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    font-weight: 500;
  }
  .collage {
    position: relative;
    display: none;
    flex: 0 1 440px;
    height: 300px;
  }
  @media (min-width: 1100px) {
    .collage {
      display: block;
    }
  }
  .float {
    position: absolute;
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: var(--tile);
    box-shadow: 0 24px 50px -18px rgba(0, 0, 0, 0.35), 0 0 0 1px color-mix(in srgb, var(--line) 60%, transparent);
  }
  .float img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .f-bio {
    width: 150px;
    height: 200px;
    right: 6%;
    top: 0;
    z-index: 2;
    transform-origin: 50% 90%;
    animation: rock 5s ease-in-out infinite;
  }
  .f-salud {
    width: 260px;
    height: 150px;
    left: 0;
    top: 40px;
    animation: floaty 6s ease-in-out infinite;
  }
  .f-vale {
    width: 220px;
    height: 128px;
    left: 30%;
    bottom: 0;
    z-index: 1;
    animation: drift 7s ease-in-out infinite;
  }
  @keyframes rock {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }
  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0) rotate(-6deg);
    }
    50% {
      transform: translateY(-12px) rotate(-6deg);
    }
  }
  @keyframes drift {
    0%,
    100% {
      transform: translateX(0) rotate(5deg);
    }
    50% {
      transform: translateX(-16px) rotate(5deg);
    }
  }

  /* ---------- Collage de portadas ---------- */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    grid-auto-rows: clamp(240px, 64vw, 340px);
    grid-auto-flow: dense;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(220px, 32vw, 320px);
    }
    .card.wide {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .grid:not(.filtered) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: clamp(60px, 5.6vw, 84px);
    }
    .grid:not(.filtered) .card {
      grid-column: var(--gc, span 4);
      grid-row: var(--gr, span 4);
    }
    /* Con un filtro activo, cuadrícula pareja de tres columnas. */
    .grid.filtered {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: clamp(240px, 22vw, 320px);
    }
    .grid.filtered .card.wide {
      grid-column: auto;
    }
  }
  .card {
    min-width: 0;
    container-type: inline-size;
  }
  /* Tarjetas angostas del collage: texto más chico y sin flecha. */
  @container (max-width: 240px) {
    .card-btn .name {
      font-size: 1.1rem;
    }
    .card-btn .overlay {
      padding: 50px 18px 18px;
    }
    .card-btn .arrow {
      display: none;
    }
  }
  .card-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    border-radius: var(--r-md);
    overflow: hidden;
    background: #0b0b0d;
    color: #ffffff;
    text-align: left;
    font: inherit;
    cursor: pointer;
    isolation: isolate;
  }
  .media {
    position: absolute;
    inset: 0;
    display: block;
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card-btn:hover .media img,
  .card-btn:focus-visible .media img {
    transform: scale(1.05);
  }
  .overlay {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 60px 70px 22px 24px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.5) 55%, transparent);
  }
  /* Desenfoque detrás del nombre para que se lea sobre capturas claras. */
  .overlay::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    mask-image: linear-gradient(to top, #000 45%, transparent);
    -webkit-mask-image: linear-gradient(to top, #000 45%, transparent);
  }
  .kind {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .name {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .arrow {
    position: absolute;
    right: 18px;
    bottom: 20px;
    z-index: 1;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.3s, transform 0.3s;
  }
  .card-btn:hover .arrow {
    background: #ffffff;
    color: #000000;
    transform: rotate(45deg);
  }

  /* Portada tipográfica para proyectos sin captura. */
  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 14px;
    padding: 26px;
    background:
      radial-gradient(circle at 85% 15%, rgba(201, 89, 221, 0.35), transparent 45%),
      radial-gradient(circle at 10% 90%, rgba(8, 148, 255, 0.3), transparent 50%),
      #0b0b0d;
    color: #ffffff;
  }
  .cover::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 36px 36px;
  }
  .cover-name {
    position: relative;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    max-width: 80%;
  }
  .cover-tech {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: #ffffff;
  }
  .cover-chip {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  /* ---------- Ficha de detalle (estilo Awwwards) ---------- */
  .pd {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--bg-alt);
    color: var(--fg);
    overflow: hidden;
  }
  .pd[open] {
    animation: pd-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pd.closing {
    animation: pd-out 0.22s ease-in forwards;
  }
  .pd::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }
  @keyframes pd-in {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.98);
    }
  }
  @keyframes pd-out {
    to {
      opacity: 0;
      transform: translateY(30px) scale(0.98);
    }
  }
  .pd-scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: 140px;
  }
  .pd-bar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px max(22px, env(safe-area-inset-right, 0px)) 16px max(22px, env(safe-area-inset-left, 0px));
    background: color-mix(in srgb, var(--bg-alt) 85%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
  }
  .pd-crumb {
    margin: 0;
    font-size: 0.95rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pd-crumb span {
    color: var(--fg-3);
  }
  .pd-actions {
    display: flex;
    gap: 8px;
  }
  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    color: var(--fg);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: color-mix(in srgb, var(--fg) 14%, transparent);
  }
  .pd-hero {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(40px, 8vh, 96px) max(22px, env(safe-area-inset-right, 0px)) clamp(32px, 5vh, 56px) max(22px, env(safe-area-inset-left, 0px));
    text-align: center;
  }
  .pd-badge {
