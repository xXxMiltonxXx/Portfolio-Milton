---
import { profile, type Category } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const filters: { id: "todos" | Category; label: string }[] = [
  { id: "todos", label: "Todos" },
  { id: "ia", label: "IA" },
  { id: "web", label: "Web" },
  { id: "movil", label: "Móvil" },
  { id: "backend", label: "Backend" },
  { id: "devops", label: "DevOps" },
];
const catLabel: Record<Category, string> = { ia: "IA", web: "Web", movil: "Móvil", backend: "Backend", devops: "DevOps" };
// Tarjetas flotantes del encabezado, como las ilustraciones de la invitación de Valentina.
const collage = [
  { src: "/proyectos/bioguard.webp", cls: "f-bio" },
  { src: "/proyectos/salud-metabolica.webp", cls: "f-salud" },
  { src: "/proyectos/valentina.webp", cls: "f-vale" },
];
// Destacados en cuadrícula; el resto en mosaico de columnas (alto natural, sin huecos).
const groups = [profile.projects.filter((p) => p.featured), profile.projects.filter((p) => !p.featured)];
const count = (id: "todos" | Category) =>
  id === "todos" ? profile.projects.length : profile.projects.filter((p) => p.categories.includes(id)).length;
---

<section id="proyectos" class="band alt">
  <div class="container wide">
    <div class="head">
      <div class="head-copy">
        <div class="section-head reveal">
          <span class="eyebrow">Proyectos</span>
          <h2 class="headline">Todo lo que he construido. <span class="soft">De agentes de IA a apps de salud.</span></h2>
        </div>
        <div class="segmented reveal" role="group" aria-label="Filtrar proyectos">
        {filters.map((f, i) => (
          <button type="button" class:list={["seg", { active: i === 0 }]} data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
            {f.label}<span class="n">{count(f.id)}</span>
          </button>
        ))}
        </div>
      </div>
      <div class="collage" aria-hidden="true">
        {collage.map((c) => (
          <figure class:list={["float", c.cls]}>
            <img src={c.src} alt="" width="600" height="400" loading="lazy" />
          </figure>
        ))}
      </div>
    </div>

    {groups.map((list, gi) => (
    <ul class={gi === 0 ? "grid" : "masonry"}>
      {list.map((p) => (
        <li class:list={["tile project reveal", { featured: p.featured }]} data-cats={p.categories.join(" ")}>
          {p.image && (
            <a class:list={["thumb", { portrait: p.portrait }]} href={p.live ?? p.repo ?? p.image} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              {p.portrait && <img class="backdrop" src={p.image} alt="" width="765" height="1024" loading="lazy" />}
              <img class="shot" src={p.image} alt="" width="1600" height="914" loading="lazy" />
            </a>
          )}
          <div class="body">
            <p class="meta">
              <span>{p.categories.map((c) => catLabel[c]).join(" · ")}</span>
              <span>{p.year}</span>
            </p>
            <h3>{p.name}</h3>
            <p class="summary">{p.summary}</p>
            <ul class="hl">
              {p.highlights.map((h) => <li>{h}</li>)}
            </ul>
            {p.tags.length > 0 && (
              <ul class="tech" aria-label="Tecnologías">
                {p.tags.map((t) => (
                  <li><TechIcon name={t} size={15} /><span>{t}</span></li>
                ))}
              </ul>
            )}
            <div class="links">
              {p.live && <a class="link" href={p.live} target="_blank" rel="noopener">Ver en vivo</a>}
              {p.repo && <a class="link" href={p.repo} target="_blank" rel="noopener">Ver código</a>}
              {!p.repo && p.private && <span class="private">Repositorio privado</span>}
            </div>
          </div>
        </li>
      ))}
    </ul>
    ))}
  </div>
</section>

<script>
  const segs = document.querySelectorAll<HTMLButtonElement>("#proyectos .seg");
  const cards = document.querySelectorAll<HTMLElement>("#proyectos .project");
  segs.forEach((seg) =>
    seg.addEventListener("click", () => {
      const f = seg.dataset.filter!;
      segs.forEach((s) => {
        s.classList.toggle("active", s === seg);
        s.setAttribute("aria-pressed", String(s === seg));
      });
      cards.forEach((card) => {
        card.hidden = !(f === "todos" || card.dataset.cats!.split(" ").includes(f));
      });
    }),
  );
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .head .section-head {
    margin-bottom: 0;
  }
  .head-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
    min-width: 0;
    flex: 1 1 520px;
  }
  .collage {
    position: relative;
    display: none;
    flex: 0 1 440px;
    height: 300px;
  }
  @media (min-width: 1100px) {
    .collage {
      display: block;
    }
  }
  .float {
    position: absolute;
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: var(--tile);
    box-shadow: 0 24px 50px -18px rgba(0, 0, 0, 0.35), 0 0 0 1px color-mix(in srgb, var(--line) 60%, transparent);
  }
  .float img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .f-bio {
    width: 150px;
    height: 200px;
    right: 6%;
    top: 0;
    z-index: 2;
    transform-origin: 50% 90%;
    animation: rock 5s ease-in-out infinite;
  }
  .f-salud {
    width: 260px;
    height: 150px;
    left: 0;
    top: 40px;
    animation: floaty 6s ease-in-out infinite;
  }
  .f-vale {
    width: 220px;
    height: 128px;
    left: 30%;
    bottom: 0;
    z-index: 1;
    animation: drift 7s ease-in-out infinite;
  }
  @keyframes rock {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }
  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0) rotate(-6deg);
    }
    50% {
      transform: translateY(-12px) rotate(-6deg);
    }
  }
  @keyframes drift {
    0%,
    100% {
      transform: translateX(0) rotate(5deg);
    }
    50% {
      transform: translateX(-16px) rotate(5deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .float {
      animation: none;
    }
  }
  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 3px;
    border-radius: 980px;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    max-width: 100%;
  }
  .seg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    background: transparent;
    color: var(--fg);
    font: 400 0.9rem var(--font);
    padding: 7px 16px;
    border-radius: 980px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .seg .n {
    font-size: 0.75rem;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .seg.active {
    background: var(--tile);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    font-weight: 500;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .project {
      grid-column: span 2;
    }
    .project.featured {
      grid-column: span 3;
    }
    /* El primer destacado ocupa toda la fila, con la captura al lado. */
    .project.featured:first-child {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: stretch;
    }
    /* La imagen va en posición absoluta para que no participe en el alto
       de la fila: así no se retroalimenta con el texto (zoom infinito en Safari). */
    .project.featured:first-child .thumb {
      margin: 10px 0 10px 10px;
      aspect-ratio: auto;
      min-height: 380px;
    }
    .project.featured:first-child .thumb .shot {
      position: absolute;
      inset: 0;
      object-position: left top;
    }
    .project.featured:first-child .body {
      padding: 40px 44px;
    }
    .project.featured:first-child h3 {
      font-size: clamp(2rem, 3vw, 2.6rem);
    }
    /* Las dos últimas tarjetas comparten la fila para no dejar huecos. */
  }
  .masonry {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    columns: 1;
    column-gap: 18px;
  }
  @media (min-width: 720px) {
    .masonry {
      columns: 2;
    }
  }
  @media (min-width: 1100px) {
    .masonry {
      columns: 3;
    }
  }
  .masonry .project {
    break-inside: avoid;
    margin-bottom: 18px;
  }
  .masonry .links {
    margin-top: 0;
  }
  .project {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .project:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
  }
  .thumb {
    display: block;
    margin: 10px 10px 0;
    border-radius: calc(var(--r-lg) - 8px);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    background: var(--bg-alt);
  }
  .thumb {
    position: relative;
  }
  .thumb .shot {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .project:hover .thumb .shot {
    transform: scale(1.04);
  }
  /* Póster vertical: completo sobre una versión difuminada de sí mismo. */
  .thumb.portrait .backdrop {
    position: absolute;
    inset: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 40px);
    object-fit: cover;
    filter: blur(24px) saturate(1.2);
    opacity: 0.85;
  }
  .thumb.portrait .shot {
    object-fit: contain;
    filter: drop-shadow(0 16px 30px rgba(0, 0, 0, 0.35));
  }
  .body {
    padding: clamp(22px, 2.6vw, 32px);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 10px;
    font-size: 0.82rem;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: 1.45rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 700;
  }
  .featured h3 {
    font-size: clamp(1.6rem, 2.4vw, 2rem);
  }
  .summary {
    margin: 10px 0 0;
    color: var(--fg-2);
    font-size: 0.97rem;
  }
  .hl {
    margin: 14px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 5px;
    font-size: 0.9rem;
    color: var(--fg-2);
  }
  .tech {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tech li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 980px;
    background: var(--tile-alt);
    font-size: 0.78rem;
    color: var(--fg);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: auto;
    padding-top: 22px;
  }
  .private {
    color: var(--fg-3);
    font-size: 0.95rem;
  }
</style>
