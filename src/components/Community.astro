---
import { profile } from "../data/profile";
const [main, ...rest] = profile.community;
---

<section id="comunidad" class="band alt">
  <div class="container wide">
    <div class="section-head reveal">
      <span class="eyebrow">Comunidad</span>
      <h2 class="headline">Construir con otros. <span class="soft">Eventos, cursos y ferias en la ULEAM y Manta.</span></h2>
    </div>
    <div class="layout">
      <a class="tile main reveal" href={main.link} target="_blank" rel="noopener">
        <span class="kicker">{main.kicker}</span>
        <h3>{main.title}</h3>
        <p>{main.text}</p>
        <dl class="facts">
          <div><dt>en premios</dt><dd>$3K+</dd></div>
          <div><dt>personas por equipo</dt><dd>1–4</dd></div>
          <div><dt>inscripción por grupo</dt><dd>$20</dd></div>
        </dl>
        <span class="link">Ver la plataforma</span>
      </a>
      <div class="side">
        {rest.map((c) => (
          <a class="tile mini reveal" href={c.link} target="_blank" rel="noopener">
            <span class="kicker">{c.kicker}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <span class="link">Ver en GitHub</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .tile:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .main {
    padding: clamp(28px, 5vw, 56px);
  }
  .kicker {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg-3);
  }
  .main h3 {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  p {
    margin: 0;
    color: var(--fg-2);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 44px;
    margin: 18px 0 14px;
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
  }
  .facts dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .facts dt {
    font-size: 0.85rem;
    color: var(--fg-2);
  }
  .main .link,
  .mini .link {
    margin-top: auto;
  }
  .side {
    display: grid;
    gap: 20px;
  }
  .mini {
    padding: 30px;
  }
  .mini h3 {
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }
</style>
