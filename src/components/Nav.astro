---
import { profile } from "../data/profile";

const items = [
  { href: "#proyectos", label: "Proyectos" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#experiencia", label: "Experiencia" },
  { href: "#tecnologias", label: "Tecnologías" },
  { href: "#certificaciones", label: "Certificaciones" },
  { href: "#comunidad", label: "Comunidad" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="nav">
  <div class="container wide nav-inner">
    <a href="#inicio" class="logo">{profile.name}</a>
    <nav aria-label="Principal">
      <ul>
        {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="cv" href="/Milton-Angamarca-CV.pdf" download aria-label="Descargar CV en PDF" title="Descargar CV en PDF"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M11 3h2v9.2l3.3-3.3 1.4 1.4L12 16 6.3 10.3l1.4-1.4L11 12.2V3zM5 18h14v2H5v-2z" /></svg><span>CV</span></a>
      <button class="theme" type="button" data-theme-toggle aria-label="Cambiar a modo oscuro" title="Cambiar tema">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
          </g>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8z" />
        </svg>
      </button>
      <button class="ask" data-open-chat type="button"><span class="ask-long">Pregúntale a mi IA</span><span class="ask-short">Mi IA</span></button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const root = document.documentElement;
  const media = matchMedia("(prefers-color-scheme: dark)");
  const current = () => (root.dataset.theme as "light" | "dark" | undefined) ?? (media.matches ? "dark" : "light");
  const sync = () => {
    const dark = current() === "dark";
    btn?.setAttribute("aria-label", dark ? "Cambiar a modo claro" : "Cambiar a modo oscuro");
    btn?.setAttribute("aria-pressed", String(dark));
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => (m.content = dark ? "#000000" : "#ffffff"));
  };
  btn?.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    root.classList.add("theme-anim");
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
    setTimeout(() => root.classList.remove("theme-anim"), 450);
  });
  media.addEventListener("change", sync);
  sync();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 52px;
  }
  .logo {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  ul {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: clamp(16px, 2.2vw, 30px);
  }
  ul a {
    white-space: nowrap;
    font-size: 0.8rem;
    color: var(--fg);
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  ul a:hover {
    opacity: 1;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .theme {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    color: var(--fg);
    cursor: pointer;
    transition: background 0.2s;
  }
  .theme:hover {
    background: color-mix(in srgb, var(--fg) 13%, transparent);
  }
  .theme svg {
    position: absolute;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s;
  }
  .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global(:root[data-theme="dark"]) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  :global(:root[data-theme="dark"]) .moon {
    opacity: 1;
    transform: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      opacity: 0;
      transform: rotate(90deg) scale(0.5);
    }
    :global(:root:not([data-theme="light"])) .moon {
      opacity: 1;
      transform: none;
    }
  }
  .cv {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 980px;
    font-size: 0.8rem;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    transition: background 0.2s;
  }
  .cv:hover {
    background: color-mix(in srgb, var(--fg) 13%, transparent);
  }
  @media (min-width: 560px) {
    .cv {
      display: inline-flex;
    }
  }
  /* Con poco ancho solo el icono, para que los enlaces no se aprieten. */
  @media (max-width: 1279px) {
    .cv span {
      display: none;
    }
    .cv {
      width: 34px;
      height: 34px;
      padding: 0;
      justify-content: center;
    }
  }
  .ask-short {
    display: none;
  }
  @media (max-width: 480px) {
    .ask-long {
      display: none;
    }
    .ask-short {
      display: inline;
    }
  }
  .logo {
    white-space: nowrap;
  }
  .ask {
    white-space: nowrap;
    border: none;
    border-radius: 980px;
    padding: 6px 14px;
    background: var(--accent);
    color: #ffffff;
    font: 400 0.8rem var(--font);
    cursor: pointer;
  }
  .ask:hover {
    background: var(--accent-hover);
  }
  @media (min-width: 1100px) {
    ul {
      display: flex;
    }
  }
</style>
