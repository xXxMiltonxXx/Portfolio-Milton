---
import { tech } from "../data/tech";

interface Props {
  name: string;
  size?: number;
}
const { name, size = 18 } = Astro.props;
const t = tech(name);
---

{t.path ? (
  <svg class="ti" viewBox="0 0 24 24" width={size} height={size} role="img" aria-label={name} fill={t.color}>
    <path d={t.path} />
  </svg>
) : (
  <span class="ti mono" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.42)}px`} aria-label={name} role="img">
    {t.monogram}
  </span>
)}

<style>
  .ti {
    flex: none;
    display: inline-block;
  }
  .mono {
    display: inline-grid;
    place-items: center;
    border-radius: 28%;
    background: var(--fg);
    color: var(--bg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
