---
import { profile } from "../data/profile";

const suggestions = [
  "¿Qué es IssA y qué hizo Milton ahí?",
  "¿Qué proyectos con IA tiene?",
  "Cuéntame sobre Hacknarok",
  "¿Cuál es su stack?",
];

// Base mínima para responder sin API key (o si la API falla).
const kb = {
  projects: profile.projects.map((p) => ({
    name: p.name,
    summary: p.summary,
    tags: p.tags,
    ai: p.categories.includes("ia"),
    live: p.live,
    repo: p.repo,
  })),
  experience: profile.experience.map((e) => ({ title: e.title, org: e.org, period: e.period, text: e.points[0] })),
  stack: profile.stack,
  links: profile.links,
  location: profile.location,
};
---

<section id="ia" class="band ai-band">
  <div class="container wide">
    <div class="ai-box reveal">
      <div class="ai-inner">
        <div class="ai-copy">
          <span class="eyebrow">Asistente con IA</span>
          <h2 class="headline">Pregúntale a <span class="ai-text">MiltonAI</span>.</h2>
          <p class="lead">Un asistente que conoce mi experiencia, mis proyectos y mi stack. Resuelve tus dudas al instante, antes de que me escribas.</p>
          <button class="btn btn-primary" data-open-chat type="button">Abrir el chat</button>
        </div>
        <div class="suggest">
          <p class="s-label">Prueba con</p>
          {suggestions.map((s) => (
            <button type="button" class="sug" data-ask={s}>{s}</button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<button class="fab" type="button" data-open-chat aria-label="Abrir asistente de IA">
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12 2.5c.4 3.9 1.6 6.3 3.4 7.9 1.6 1.4 3.8 2.1 6.1 2.1-2.3 0-4.5.7-6.1 2.1-1.8 1.6-3 4-3.4 7.9-.4-3.9-1.6-6.3-3.4-7.9-1.6-1.4-3.8-2.1-6.1-2.1 2.3 0 4.5-.7 6.1-2.1 1.8-1.6 3-4 3.4-7.9z"/></svg>
</button>

<div class="chat" id="chat" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
  <header class="chat-head">
    <div class="bot">
      <span class="avatar" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2.5c.4 3.9 1.6 6.3 3.4 7.9 1.6 1.4 3.8 2.1 6.1 2.1-2.3 0-4.5.7-6.1 2.1-1.8 1.6-3 4-3.4 7.9-.4-3.9-1.6-6.3-3.4-7.9-1.6-1.4-3.8-2.1-6.1-2.1 2.3 0 4.5-.7 6.1-2.1 1.8-1.6 3-4 3.4-7.9z"/></svg></span>
      <div>
        <strong id="chat-title">MiltonAI</strong>
        <span class="online">En línea · responde sobre Milton</span>
      </div>
    </div>
    <button type="button" class="close" data-close-chat aria-label="Cerrar">✕</button>
  </header>
  <ol class="log" aria-live="polite">
    <li class="msg bot-msg">¡Hola! Soy el asistente de {profile.shortName}. Pregúntame por su experiencia, sus proyectos con IA, Hacknarok o su stack.</li>
  </ol>
  <div class="quick">
    {suggestions.map((s) => <button type="button" class="q" data-ask={s}>{s}</button>)}
  </div>
  <form class="composer">
    <input name="q" autocomplete="off" placeholder="Escribe tu pregunta…" maxlength="500" aria-label="Tu pregunta" />
    <button type="submit" aria-label="Enviar"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 4l7 7-1.4 1.4L13 7.8V20h-2V7.8l-4.6 4.6L5 11z"/></svg></button>
  </form>
</div>

<script type="application/json" id="chat-kb" set:html={JSON.stringify(kb)} />

<script>
  type Msg = { role: "user" | "assistant"; content: string };
  type KB = {
    projects: { name: string; summary: string; tags: string[]; ai: boolean; live?: string; repo?: string }[];
    experience: { title: string; org: string; period: string; text: string }[];
    stack: { group: string; items: string[] }[];
    links: { github: string; linkedin: string };
    location: string;
  };

  const kb: KB = JSON.parse(document.getElementById("chat-kb")!.textContent!);
  const panel = document.getElementById("chat")!;
  const log = panel.querySelector<HTMLOListElement>(".log")!;
  const form = panel.querySelector<HTMLFormElement>(".composer")!;
  const input = form.querySelector<HTMLInputElement>("input")!;
  const quick = panel.querySelector<HTMLElement>(".quick")!;
  const history: Msg[] = [];
  let busy = false;
  let remote = true;

  const open = () => {
    panel.hidden = false;
    requestAnimationFrame(() => panel.classList.add("open"));
    input.focus({ preventScroll: true });
  };
  const close = () => {
    panel.classList.remove("open");
    setTimeout(() => (panel.hidden = true), 250);
  };

  document.querySelectorAll("[data-open-chat]").forEach((b) => b.addEventListener("click", open));
  panel.querySelector("[data-close-chat]")!.addEventListener("click", close);
  document.addEventListener("keydown", (e) => e.key === "Escape" && !panel.hidden && close());
  document.querySelectorAll<HTMLElement>("[data-ask]").forEach((b) =>
    b.addEventListener("click", () => {
      open();
      ask(b.dataset.ask!);
    }),
  );
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (q) ask(q);
  });

  function bubble(role: "user" | "bot", text = "") {
    const li = document.createElement("li");
    li.className = `msg ${role}-msg`;
    li.textContent = text;
    log.appendChild(li);
    log.scrollTop = log.scrollHeight;
    return li;
  }

  async function ask(q: string) {
    if (busy) return;
    busy = true;
    input.value = "";
    quick.hidden = true;
    bubble("user", q);
    history.push({ role: "user", content: q });
    const out = bubble("bot");
    out.classList.add("typing");

    let answer = "";
    if (remote) {
      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages: history }),
        });
        if (!res.ok || !res.body) throw new Error(String(res.status));
        const reader = res.body.getReader();
        const dec = new TextDecoder();
        out.classList.remove("typing");
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          answer += dec.decode(value, { stream: true });
          out.textContent = answer;
          log.scrollTop = log.scrollHeight;
        }
      } catch {
        remote = false;
      }
    }
    if (!answer) {
      answer = local(q);
      await new Promise((r) => setTimeout(r, 450));
      out.classList.remove("typing");
      await typeOut(out, answer);
    }
    history.push({ role: "assistant", content: answer });
    busy = false;
  }

  async function typeOut(el: HTMLElement, text: string) {
    const step = Math.max(2, Math.round(text.length / 90));
    for (let i = 0; i <= text.length; i += step) {
      el.textContent = text.slice(0, i);
      log.scrollTop = log.scrollHeight;
      await new Promise((r) => setTimeout(r, 12));
    }
    el.textContent = text;
  }

  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

  function local(raw: string): string {
    const q = ` ${norm(raw).replace(/[¿?¡!.,]/g, " ")} `;
    const has = (...w: string[]) => w.some((x) => q.includes(x));

    if (has("hacknarok", "hackat", "hackaton", "evento")) {
      return "Milton creó y organizó Hacknarok 2024 en Manta: una hackathon con más de $3.000 en premios, mentores por temática, rúbricas de evaluación y equipos de 1 a 4 personas. Además construyó la plataforma oficial (Angular + Supabase) para inscripciones, entregas y votación de jurados.";
    }
    const stop = new Set(["para", "con", "tus", "motor", "chat", "2024"]);
    const proj = kb.projects.find((p) =>
      norm(p.name)
        .split(/[\s—-]+/)
        .filter((w) => w.length > 3 && !stop.has(w))
        .some((w) => q.includes(w)),
    );
    if (proj && !has("proyectos")) {
      const extra = proj.live ? ` Puedes verlo en ${proj.live}.` : proj.repo ? ` El código está en ${proj.repo}.` : "";
      return `${proj.name}: ${proj.summary} Stack: ${proj.tags.join(", ")}.${extra}`;
    }
    if (has(" ia", "ia ", "inteligencia", " ai", "llm", "agente", "rag", "machine")) {
      const ai = kb.projects.filter((p) => p.ai).map((p) => `• ${p.name}`);
      return `Estos son sus proyectos con IA:\n${ai.join("\n")}\nTrabaja con LangGraph, LangChain, OpenAI, RAG, PyTorch y modelos on-device.`;
    }
    if (has("stack", "tecnolog", "lenguaje", "framework", "herramienta", "sabe")) {
      return kb.stack.map((s) => `${s.group}: ${s.items.join(", ")}`).join("\n");
    }
    if (has("experiencia", "trabaj", "empresa", "zgames", "issa", "iess", "rol", "cargo")) {
      return kb.experience.map((e) => `• ${e.title} — ${e.org} (${e.period})`).join("\n");
    }
    if (has("proyecto", "portafolio", "hizo", "construy")) {
      return `Algunos de sus proyectos:\n${kb.projects
        .slice(0, 8)
        .map((p) => `• ${p.name}`)
        .join("\n")}\nPregúntame por cualquiera para más detalle.`;
    }
    if (has("contact", "correo", "email", "linkedin", "contratar", "hablar", "escrib")) {
      return `Puedes contactarlo por LinkedIn (${kb.links.linkedin}) o ver su código en GitHub (${kb.links.github}).`;
    }
    if (has("donde", "ubica", "vive", "pais", "ciudad", "estudi", "universidad", "uleam")) {
      return `Milton vive en ${kb.location} y se formó en la ULEAM (Universidad Laica Eloy Alfaro de Manabí), donde también participó en la Comunidad Microsoft y en la Casa Abierta.`;
    }
    if (has("hola", "buenas", "hey", "que tal")) {
      return "¡Hola! Pregúntame por la experiencia de Milton, sus proyectos con IA, Hacknarok o su stack.";
    }
    return "No tengo ese dato exacto, pero puedo contarte sobre su experiencia en IssA, sus proyectos con IA, Hacknarok o su stack. Para algo más específico, escríbele por LinkedIn.";
  }
</script>

<style>
  .ai-band {
    background: var(--bg);
  }
  .ai-box {
    position: relative;
    isolation: isolate;
    border-radius: var(--r-lg);
    padding: 2px;
    background: var(--ai);
  }
  .ai-box::before {
    content: "";
    position: absolute;
    inset: 10px;
    border-radius: inherit;
    background: var(--ai);
    filter: blur(36px);
    opacity: 0.35;
    z-index: -1;
  }
  .ai-inner {
    border-radius: calc(var(--r-lg) - 2px);
    background: var(--tile);
    padding: clamp(28px, 5vw, 64px);
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .ai-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .ai-copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .ai-copy .btn {
    margin-top: 10px;
  }
  .ai-text {
    background: var(--ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .suggest {
    display: grid;
    gap: 10px;
  }
  .s-label {
    margin: 0 0 4px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg-3);
  }
  .sug {
    text-align: left;
    padding: 16px 20px;
    border-radius: var(--r-md);
    border: none;
    background: var(--bg-alt);
    color: var(--fg);
    font: 400 1rem var(--font);
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: background 0.2s;
  }
  .sug:hover {
    background: var(--tile-alt);
  }

  .fab {
    position: fixed;
    right: max(20px, env(safe-area-inset-right, 0px));
    bottom: max(20px, env(safe-area-inset-bottom, 0px));
    z-index: 60;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    display: grid;
    place-items: center;
    background: var(--fg);
    color: var(--bg);
    cursor: pointer;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s;
  }
  .fab::before {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--ai);
    z-index: -1;
  }
  .fab:hover {
    transform: scale(1.06);
  }

  .chat {
    position: fixed;
    z-index: 70;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: calc(max(20px, env(safe-area-inset-bottom, 0px)) + 70px);
    width: min(400px, calc(100vw - 32px));
    height: min(620px, calc(100dvh - 130px));
    display: flex;
    flex-direction: column;
    background: var(--tile);
    border-radius: 24px;
    box-shadow: 0 0 0 1.5px transparent, 0 30px 80px rgba(0, 0, 0, 0.28);
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition: opacity 0.25s, transform 0.25s;
  }
  .chat::before {
    content: "";
    position: absolute;
    inset: -1.5px;
    border-radius: 25.5px;
    background: var(--ai);
    z-index: -1;
  }
  .chat.open {
    opacity: 1;
    transform: none;
  }
  .chat[hidden] {
    display: none;
  }
  .chat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
    border-radius: 24px 24px 0 0;
    background: var(--tile);
  }
  .bot {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .bot div {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ai);
    color: #ffffff;
  }
  .online {
    font-size: 0.75rem;
    color: var(--fg-3);
  }
  .close {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: var(--bg-alt);
    color: var(--fg-2);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .log {
    flex: 1;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--tile);
  }
  .log :global(.msg) {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 20px;
    font-size: 0.95rem;
    line-height: 1.4;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.bot-msg) {
    align-self: flex-start;
    background: var(--bg-alt);
    color: var(--fg);
    border-bottom-left-radius: 6px;
  }
  .log :global(.user-msg) {
    align-self: flex-end;
    background: var(--accent);
    color: #ffffff;
    border-bottom-right-radius: 6px;
  }
  .log :global(.typing)::after {
    content: "• • •";
    letter-spacing: 2px;
    color: var(--fg-3);
    animation: blink 1.2s infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .quick {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 0 18px 12px;
    background: var(--tile);
  }
  .quick[hidden] {
    display: none;
  }
  .q {
    flex: none;
    padding: 7px 13px;
    border-radius: 980px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--link);
    font: 400 0.82rem var(--font);
    cursor: pointer;
  }
  .composer {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 24px 24px;
    background: var(--tile);
  }
  .composer input {
    flex: 1;
    min-width: 0;
    padding: 11px 16px;
    border-radius: 980px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    font: 0.95rem var(--font);
    outline: none;
  }
  .composer input:focus {
    border-color: var(--accent);
  }
  .composer button {
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 50%;
    border: none;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: #ffffff;
    cursor: pointer;
  }
</style>
