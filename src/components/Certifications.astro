---
import { profile } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const certs = profile.certifications;
---

{certs.length > 0 && (
  <section id="certificaciones" class="band">
    <div class="container wide split">
      <div class="section-head">
        <span class="eyebrow">Certificaciones</span>
        <h2 class="headline">Aprendizaje continuo. <span class="soft">Cursos completados y verificables.</span></h2>
        <p class="total"><strong>{certs.reduce((h, c) => h + (parseFloat(c.hours ?? "0") || 0), 0)} horas</strong> de formación certificada.</p>
      </div>
      <ul class="grid split-body">
        {certs.map((c) => (
          <li class="tile cert">
            {c.image && (
              <a class="thumb" href={c.url ?? c.image} target="_blank" rel="noopener">
                <img src={c.image} alt={`Certificado: ${c.title}`} width="800" height="600" loading="lazy" />
              </a>
            )}
            <div class="body">
              <p class="issuer">
                <TechIcon name={c.issuer} size={18} />
                <span>{c.issuer}</span>
                {c.date && <span class="date">{c.date}</span>}
              </p>
              <h3>{c.title}</h3>
              {(c.instructor || c.hours) && (
                <p class="meta">{[c.instructor && `Instructor: ${c.instructor}`, c.hours].filter(Boolean).join(" · ")}</p>
              )}
              {c.credential && <p class="meta credential">ID del certificado: {c.credential}</p>}
              {c.url && <a class="link" href={c.url} target="_blank" rel="noopener">Verificar certificado</a>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .total {
    margin: 6px 0 0;
    color: var(--fg-2);
  }
  .total strong {
    color: var(--fg);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Si quedan impares, el último ocupa la fila entera con la imagen al lado. */
    .cert:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      flex-direction: row;
    }
    .cert:last-child:nth-child(odd) .thumb {
      flex: 0 0 50%;
      border-bottom: none;
      border-right: 1px solid var(--line);
    }
    .cert:last-child:nth-child(odd) .body {
      flex: 1;
      justify-content: center;
    }
  }
  .cert {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--bg-alt);
    box-shadow: none;
  }
  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .thumb:hover img {
    transform: scale(1.03);
  }
  .body {
    padding: 24px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .issuer {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--fg-2);
  }
  .date {
    margin-left: auto;
    color: var(--fg-3);
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .meta {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.92rem;
  }
  .credential {
    font-size: 0.82rem;
    color: var(--fg-3);
    overflow-wrap: anywhere;
  }
  .link {
    margin-top: auto;
    padding-top: 6px;
  }
</style>
