---
import { profile } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const shots = profile.projects.filter((p) => p.image);
const host = (url?: string) => (url ? new URL(url).host : "");
---

<section id="vitrina" class="showcase">
  <div class="pin">
    <div class="container wide head">
      <div>
        <span class="eyebrow">En producción</span>
        <h2 class="headline" data-split>Hecho y lanzado. <span class="soft">Desliza por mis productos.</span></h2>
      </div>
      <p class="counter" aria-hidden="true"><span data-sc-index>01</span> / {String(shots.length).padStart(2, "0")}</p>
    </div>

    <div class="viewport">
      <ul class="track" data-sc-track>
        {shots.map((p, i) => (
          <li class="slide" data-sc-slide>
            <a class="frame" href={p.live ?? p.repo} target="_blank" rel="noopener">
              <div class="bar">
                <span class="dots"><i></i><i></i><i></i></span>
                <span class="url">{host(p.live ?? p.repo)}</span>
              </div>
              <div class="screen">
                <img src={p.image} alt={`Captura de ${p.name}`} width="1600" height="914" loading={i < 2 ? "eager" : "lazy"} data-sc-img />
              </div>
            </a>
            <div class="caption">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <div class="cap-body">
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
                <ul class="mini-tech">
                  {p.tags.slice(0, 6).map((t) => (
                    <li title={t}><TechIcon name={t} size={16} /></li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="container wide">
      <div class="progress" aria-hidden="true"><span data-sc-progress></span></div>
    </div>
  </div>
</section>

<style>
  .showcase {
    background: var(--bg-alt);
    overflow: hidden;
  }
  .pin {
    padding-block: clamp(64px, 9vw, 110px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
  }
  @media (min-width: 900px) {
    .pin {
      min-height: 100vh;
      min-height: 100dvh;
      justify-content: center;
      padding-block: 84px 36px;
      gap: 32px;
    }
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .head .headline {
    margin-top: 12px;
    max-width: 18ch;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }
  @media (min-width: 900px) {
    .head .headline {
      max-width: none;
      font-size: clamp(2rem, 3.4vw, 3rem);
    }
    .slide {
      width: min(62vw, 860px, calc((100dvh - 520px) * 1.75));
      min-width: 520px;
    }
    .cap-body p {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
  .counter {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--fg-3);
    font-size: 1.05rem;
    white-space: nowrap;
  }
  .counter span {
    color: var(--fg);
    font-weight: 600;
  }
  .viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .viewport::-webkit-scrollbar {
    display: none;
  }
  :global(.sc-pinned) .viewport {
    overflow: visible;
  }
  .track {
    list-style: none;
    margin: 0;
    display: flex;
    gap: clamp(20px, 3vw, 40px);
    width: max-content;
    padding-inline: max(22px, calc((100vw - var(--max-wide)) / 2 + 22px));
  }
  .slide {
    width: min(78vw, 860px);
    scroll-snap-align: center;
    display: grid;
    gap: 22px;
  }
  .frame {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    background: var(--tile);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.35), 0 0 0 1px color-mix(in srgb, var(--line) 60%, transparent);
    transition: transform 0.4s;
  }
  .frame:hover {
    transform: translateY(-4px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 38px;
    padding: 0 14px;
    background: var(--tile);
    border-bottom: 1px solid var(--line);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .dots i:nth-child(1) {
    background: #ff5f57;
  }
  .dots i:nth-child(2) {
    background: #febc2e;
  }
  .dots i:nth-child(3) {
    background: #28c840;
  }
  .url {
    flex: 1;
    max-width: 360px;
    margin: 0 auto;
    padding: 4px 12px;
    border-radius: 8px;
    background: var(--bg-alt);
    color: var(--fg-3);
    font-size: 0.75rem;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .screen {
    aspect-ratio: 16 / 9.15;
    max-width: 100%;
    overflow: hidden;
  }
  .screen img {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: top center;
  }
  .caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
  }
  .num {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
  }
  .cap-body {
    display: grid;
    gap: 8px;
  }
  h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.025em;
    font-weight: 700;
  }
  .cap-body p {
    margin: 0;
    color: var(--fg-2);
    max-width: 62ch;
  }
  .mini-tech {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    gap: 8px;
    color: var(--fg);
  }
  .mini-tech li {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--tile);
  }
  @media (min-width: 900px) and (max-height: 960px) {
    .mini-tech {
      display: none;
    }
  }
  .progress {
    height: 2px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--ai);
    transform: scaleX(0);
    transform-origin: left center;
  }
</style>
