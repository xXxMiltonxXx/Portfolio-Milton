---
import { profile } from "../data/profile";
import TechIcon from "./TechIcon.astro";
---

<section id="experiencia" class="band">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Experiencia</span>
      <h2 class="headline">Dónde he construido. <span class="soft">Y qué aprendí haciéndolo.</span></h2>
    </div>
    <ol class="list">
      {profile.experience.map((e) => (
        <li class="row reveal">
          <span class="period">{e.period}</span>
          <div class="body">
            <h3>{e.title}</h3>
            <p class="org">
              {"link" in e && e.link ? <a class="link" href={e.link} target="_blank" rel="noopener">{e.org}</a> : e.org}
            </p>
            <ul class="points">
              {e.points.map((p) => <li>{p}</li>)}
            </ul>
            {e.tags.length > 0 && (
              <ul class="tech">
                {e.tags.map((t) => (
                  <li><TechIcon name={t} size={16} /><span>{t}</span></li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    gap: 8px 40px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .row {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }
  .period {
    color: var(--fg-3);
    font-size: 0.95rem;
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .org {
    margin: 4px 0 0;
    color: var(--fg-2);
    font-size: 1.05rem;
  }
  .points {
    margin: 16px 0 0;
    padding-left: 20px;
    color: var(--fg-2);
    display: grid;
    gap: 8px;
    max-width: 68ch;
  }
  .tech {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tech li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: 980px;
    background: var(--bg-alt);
    font-size: 0.85rem;
    color: var(--fg);
  }
</style>
