---
import { profile } from "../data/profile";
import TechIcon from "./TechIcon.astro";
---

<section id="experiencia" class="band">
  <div class="container wide split">
    <div class="section-head reveal">
      <span class="eyebrow">Experiencia</span>
      <h2 class="headline">Dónde he construido. <span class="soft">Y qué aprendí haciéndolo.</span></h2>
      <p class="count"><strong>{profile.experience.length}</strong> etapas · de cursos en la ULEAM a productos con IA en producción.</p>
    </div>

    <div class="split-body timeline">
      <span class="tl-track" aria-hidden="true"></span>
      <span class="tl-fill" data-progress-line aria-hidden="true"></span>
      <ol class="list">
        {profile.experience.map((e) => (
          <li class="row reveal">
            <div class="top">
              <span class="period">{e.period}</span>
              <p class="org">
                {"link" in e && e.link ? <a class="link" href={e.link} target="_blank" rel="noopener">{e.org}</a> : e.org}
              </p>
            </div>
            <h3>{e.title}</h3>
            <ul class="points">
              {e.points.map((p) => <li>{p}</li>)}
            </ul>
            {e.tags.length > 0 && (
              <ul class="tech">
                {e.tags.map((t) => (
                  <li><TechIcon name={t} size={16} /><span>{t}</span></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .count {
    margin: 6px 0 0;
    color: var(--fg-2);
    font-size: 0.98rem;
    max-width: 34ch;
  }
  .count strong {
    color: var(--fg);
  }
  .timeline {
    position: relative;
    padding-left: 36px;
  }
  .tl-track,
  .tl-fill {
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
  }
  .tl-track {
    background: var(--line);
  }
  .tl-fill {
    background: var(--ai);
    transform-origin: top center;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .row {
    position: relative;
    padding: 28px 30px;
    border-radius: var(--r-lg);
    background: var(--bg-alt);
    transition: background 0.3s;
  }
  .row:hover {
    background: var(--tile-alt);
  }
  .row::before {
    content: "";
    position: absolute;
    left: -36px;
    top: 34px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--fg-3);
  }
  .row:first-child::before {
    background: var(--ai);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 20px;
    font-size: 0.92rem;
  }
  .period {
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .org {
    margin: 0;
    color: var(--fg-2);
    font-weight: 500;
  }
  .org .link {
    font-size: inherit;
  }
  h3 {
    margin-top: 10px;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    letter-spacing: -0.02em;
  }
  .points {
    margin: 14px 0 0;
    padding-left: 20px;
    color: var(--fg-2);
    display: grid;
    gap: 8px;
    max-width: 72ch;
  }
  .tech {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tech li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: 980px;
    background: var(--tile);
    font-size: 0.85rem;
    color: var(--fg);
  }
</style>
