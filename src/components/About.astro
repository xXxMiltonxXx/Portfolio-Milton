---
import { profile } from "../data/profile";
---

<section id="sobre-mi" class="band alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Sobre mí</span>
      <h2 class="headline">De Manta al mundo. <span class="soft">Ingeniería con mentalidad de producto.</span></h2>
    </div>
    <div class="grid">
      <div class="text reveal">
        {profile.about.map((p) => <p set:html={p} />)}
      </div>
      <ul class="pillars">
        {profile.pillars.map((p) => (
          <li class="reveal">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 72px;
    }
  }
  .text {
    display: grid;
    gap: 20px;
  }
  .text p {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--fg-2);
  }
  .text :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
  .pillars li {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }
  .pillars p {
    margin: 0;
    color: var(--fg-2);
    font-size: 1rem;
  }
</style>
