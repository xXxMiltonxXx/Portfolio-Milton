---
import { profile } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const total = profile.stack.reduce((n, g) => n + g.items.length, 0);
---

<section id="tecnologias" class="band">
  <div class="container wide split">
    <div class="section-head reveal">
      <span class="eyebrow">Tecnologías</span>
      <h2 class="headline">{total} herramientas. <span class="soft">Usadas en proyectos reales, no en tutoriales.</span></h2>
      <ul class="legend">
        {profile.stack.map((g) => (
          <li><span>{g.group}</span><strong>{g.items.length}</strong></li>
        ))}
      </ul>
    </div>
    <div class="groups split-body">
      {profile.stack.map((g) => (
        <div class="group reveal">
          <h3>{g.group} <span>{g.items.length}</span></h3>
          <ul class="tiles">
            {g.items.map((i) => (
              <li>
                <TechIcon name={i} size={34} />
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: 48px;
  }
  .group {
    display: grid;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .group:first-child {
    padding-top: 0;
    border-top: none;
  }
  .legend {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .legend li {
    display: flex;
    justify-content: space-between;
    padding-block: 10px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--fg-2);
  }
  .legend strong {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  h3 span {
    color: var(--fg-3);
    font-weight: 500;
    font-size: 0.9em;
    margin-left: 6px;
  }
  h3 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(108px, 1fr));
    gap: 12px;
  }
  .tiles li {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 22px 8px 16px;
    border-radius: var(--r-md);
    background: var(--bg-alt);
    color: var(--fg);
    text-align: center;
    transition: transform 0.25s, background 0.25s;
  }
  .tiles li:hover {
    transform: translateY(-3px);
    background: var(--tile-alt);
  }
  .tiles span {
    font-size: 0.82rem;
    line-height: 1.2;
    color: var(--fg-2);
  }
</style>
