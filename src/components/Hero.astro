---
import { profile } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const marqueeTech = ["OpenAI", "LangGraph", "Python", "FastAPI", "React", "Next.js", "Angular", "Flutter", "Go", "Supabase", "PostgreSQL", "Docker", "Nginx", "Cloudflare"];

// Titular partido en palabras para animarlas una a una.
const line1 = [{ w: "Software" }, { w: "que" }, { w: "piensa", ai: true }];
const line2 = [{ w: "Productos" }, { w: "que" }, { w: "funcionan" }];

// Chips flotantes alrededor de la foto: lo que construyo.
const chips = [
  { label: "Agentes de IA", sub: "LangGraph · RAG", pos: "c1" },
  { label: "CTO de IssA", sub: "CRM con IA", pos: "c2" },
  { label: "Apps de salud", sub: "Flutter · Go", pos: "c3" },
  { label: "Hacknarok 2024", sub: "Creador", pos: "c4" },
];

function countParts(v: string) {
  const m = v.match(/^(\D*)(\d+)(.*)$/);
  return m && !v.includes("/") ? { prefix: m[1], n: m[2], suffix: m[3] } : null;
}
---

<section id="inicio" class="hero">
  <svg class="lines" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="g-ai" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#0894ff" />
        <stop offset="0.35" stop-color="#c959dd" />
        <stop offset="0.7" stop-color="#ff2e54" />
        <stop offset="1" stop-color="#ff9004" />
      </linearGradient>
    </defs>
    <path class="ln ln-ai" d="M-20,640 C200,560 380,600 560,520 S880,260 1080,300 S1360,420 1460,330" />
    <path class="ln ln-soft" d="M-20,700 C240,640 440,660 660,600 S1000,420 1200,440 S1380,520 1460,480" />
    <path class="ln ln-soft2" d="M-20,520 C220,600 420,660 640,620 S980,380 1200,360 S1380,420 1460,380" />
  </svg>

  <div class="container wide stage">
    <div class="copy">
      <h1 class="headline" aria-label="Software que piensa. Productos que funcionan.">
        <span class="line" aria-hidden="true">
          {line1.map((x) => (
            <span class="w">
              <span class="wi">{x.ai ? <><span class="ai-text">{x.w}</span>.</> : x.w}</span>
            </span>
          ))}
        </span>
        <span class="line" aria-hidden="true">
          {line2.map((x, i) => (
            <span class="w"><span class="wi">{x.w}{i === line2.length - 1 ? "." : ""}</span></span>
          ))}
        </span>
      </h1>
      <p class="lead" data-hero="fade">{profile.tagline}</p>
      <div class="ctas" data-hero="fade">
        <button class="btn btn-primary" data-open-chat type="button">Habla con mi IA</button>
        <a class="btn btn-secondary" href="/Milton-Angamarca-CV.pdf" download><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M11 3h2v9.2l3.3-3.3 1.4 1.4L12 16 6.3 10.3l1.4-1.4L11 12.2V3zM5 18h14v2H5v-2z" /></svg>Descargar CV</a>
        <a class="link" href="#proyectos">Ver proyectos</a>
      </div>
      <p class="name" data-hero="fade">
        <span class="status" aria-hidden="true"></span>
        {profile.name} · {profile.location}
      </p>
    </div>

    <div class="visual">
      <div class="orbit" aria-hidden="true">
        <span class="ring r1"></span>
        <span class="ring r2"></span>
        <span class="ring r3"></span>
      </div>
      <div class="photo" data-hero="photo">
        <img
          src={profile.photo}
          alt={`Foto de ${profile.name}`}
          width="400"
          height="400"
          data-fallback={profile.photoFallback}
          onerror="var f=this.dataset.fallback;if(f&&this.getAttribute('src')!==f){this.setAttribute('src',f)}else{this.remove()}"
        />
        <span class="initials" aria-hidden="true">{profile.initials}</span>
      </div>
      {chips.map((c) => (
        <div class:list={["chip", c.pos]} data-hero="chip" aria-hidden="true">
          <span class="dot"></span>
          <span class="chip-text"><strong>{c.label}</strong><small>{c.sub}</small></span>
        </div>
      ))}
    </div>
  </div>

  <div class="container wide">
    <dl class="stats">
      <span class="rule" data-line></span>
      {profile.stats.map((s) => {
        const c = countParts(s.value);
        return (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>
              {c ? <>{c.prefix}<span data-count={c.n}>{c.n}</span>{c.suffix}</> : s.value}
            </dd>
          </div>
        );
      })}
    </dl>
  </div>
</section>

<div class="marquee" aria-label="Tecnologías principales">
  <div class="track">
    {[0, 1].map((k) => (
      <ul aria-hidden={k === 1 ? "true" : undefined}>
        {marqueeTech.map((t) => (
          <li><TechIcon name={t} size={22} /><span>{t}</span></li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 52px);
    display: flex;
    flex-direction: column;
    padding-block: clamp(28px, 5svh, 64px) clamp(20px, 3svh, 32px);
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  @media (min-width: 980px) {
    /* Las líneas se apagan detrás del texto y brillan junto a la foto. */
    .lines {
      mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.25) 42%, #000 62%);
      -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.25) 42%, #000 62%);
    }
  }
  .ln {
    fill: none;
    stroke-linecap: round;
  }
  .ln-ai {
    stroke: url(#g-ai);
    stroke-width: 2.5;
    opacity: 0.85;
  }
  .ln-soft,
  .ln-soft2 {
    stroke: var(--line);
    stroke-width: 1.2;
  }
  .stage {
    position: relative;
    flex: 1;
    display: grid;
    align-items: center;
    gap: 40px;
  }
  @media (min-width: 980px) {
    .stage {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 48px;
    }
  }

  /* ---------- Texto ---------- */
  .copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 30px 0 0;
    padding: 6px 14px 6px 10px;
    border-radius: 980px;
    background: color-mix(in srgb, var(--bg-alt) 80%, transparent);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--fg-2);
  }
  .status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #30d158;
    box-shadow: 0 0 0 4px color-mix(in srgb, #30d158 20%, transparent);
  }
  .headline {
    font-size: clamp(2.6rem, 4.7vw, 4.9rem);
    line-height: 1.02;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
  }
  .w {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .wi {
    display: inline-block;
    will-change: transform;
  }
  .ai-text {
    background: var(--ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: 22px;
    max-width: 52ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 30px;
  }
  /* ---------- Foto ---------- */
  .visual {
    position: relative;
    justify-self: center;
    width: min(100%, 78vw, 340px);
    aspect-ratio: 1;
    max-width: 100%;
  }
  @media (min-width: 980px) {
    .visual {
      width: min(100%, 56svh, 500px);
    }
  }
  .orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border: 1px dashed var(--line);
    translate: -50% -50%;
  }
  .r1 {
    width: 74%;
    height: 74%;
  }
  .r2 {
    width: 96%;
    height: 96%;
    border-style: solid;
    opacity: 0.7;
  }
  .r3 {
    width: 122%;
    height: 122%;
    opacity: 0.45;
  }
  .photo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-alt);
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 8px color-mix(in srgb, var(--line) 70%, transparent), 0 30px 70px rgba(0, 0, 0, 0.2);
  }
  .photo img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--fg-3);
  }
  .chip {
    position: absolute;
    display: none;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 12px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--tile) 85%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1), inset 0 0 0 1px color-mix(in srgb, var(--line) 70%, transparent);
    white-space: nowrap;
    z-index: 2;
  }
  @media (min-width: 640px) {
    .chip {
      display: flex;
    }
  }
  .chip-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .chip strong {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .chip small {
    font-size: 0.75rem;
    color: var(--fg-3);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ai);
    flex: none;
  }
  .c1 {
    top: 6%;
    left: -8%;
  }
  .c2 {
    top: 20%;
    right: -2%;
  }
  .c3 {
    bottom: 18%;
    left: -14%;
  }
  .c4 {
    bottom: 4%;
    right: 0;
  }
  @media (min-width: 1240px) {
    .c2 {
      right: -12%;
    }
    .c4 {
      right: -4%;
    }
  }

  /* ---------- Cifras ---------- */
  .stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 32px 0 0;
    padding-top: 22px;
  }
  @media (min-width: 760px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .rule {
    position: absolute;
    inset: 0 0 auto;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }
  .stat dd {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stat dt {
    color: var(--fg-2);
    font-size: 0.88rem;
  }

  /* ---------- Cinta de tecnologías ---------- */
  .marquee {
    position: relative;
    padding-block: 26px;
    border-block: 1px solid var(--line);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee 45s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .track ul {
    display: flex;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0 6px;
  }
  .track li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 980px;
    background: var(--bg-alt);
    color: var(--fg);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
