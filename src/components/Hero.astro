---
import { profile } from "../data/profile";
import TechIcon from "./TechIcon.astro";

const featuredTech = ["OpenAI", "LangGraph", "Python", "FastAPI", "React", "Next.js", "Flutter", "Go", "Supabase", "Docker"];
---

<section id="inicio" class="hero">
  <div class="container">
    <div class="photo">
      <img
        src={profile.photo}
        alt={`Foto de ${profile.name}`}
        width="144"
        height="144"
        data-fallback={profile.photoFallback}
        onerror="var f=this.dataset.fallback;if(f&&this.getAttribute('src')!==f){this.setAttribute('src',f)}else{this.remove()}"
      />
      <span class="initials" aria-hidden="true">{profile.initials}</span>
    </div>
    <p class="name">{profile.name}</p>
    <h1 class="headline">Software que <span class="ai-text">piensa</span>.<br />Productos que funcionan.</h1>
    <p class="lead">{profile.tagline}</p>
    <div class="ctas">
      <button class="btn btn-primary" data-open-chat type="button">Habla con mi IA</button>
      <a class="link" href="#proyectos">Ver proyectos</a>
    </div>
    <ul class="tech" aria-label="Tecnologías principales">
      {featuredTech.map((t) => (
        <li title={t}><TechIcon name={t} size={26} /></li>
      ))}
    </ul>
  </div>

  <div class="container">
    <dl class="stats">
      {profile.stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 9vw, 104px) clamp(56px, 8vw, 88px);
    text-align: center;
  }
  .hero .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .photo {
    position: relative;
    width: 144px;
    height: 144px;
    max-width: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-alt);
    margin-bottom: 22px;
  }
  .photo img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--fg-3);
  }
  .name {
    margin: 0 0 10px;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--fg-2);
  }
  .headline {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    line-height: 1.04;
  }
  .ai-text {
    background: var(--ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: 22px;
    max-width: 640px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 28px;
    margin-top: 32px;
  }
  .tech {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    color: var(--fg);
  }
  .tech li {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--bg-alt);
  }
  .stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 20px;
    margin: clamp(56px, 8vw, 88px) 0 0;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }
  .stat dd {
    margin: 0;
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stat dt {
    color: var(--fg-2);
    font-size: 0.9rem;
  }
</style>
