---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<section id="contacto" class="band">
  <div class="container contact reveal">
    <h2 class="headline">Hablemos.</h2>
    <p class="lead">¿Tienes un producto, una idea con IA o un evento tech en mente? Escríbeme, o pregúntale primero a mi asistente.</p>
    <div class="ctas">
      <a class="btn btn-primary" href={profile.links.linkedin} target="_blank" rel="noopener">Escríbeme en LinkedIn</a>
      <a class="btn btn-secondary" href={profile.links.github} target="_blank" rel="noopener">Ver mi GitHub</a>
    </div>
    <button class="link ask" data-open-chat type="button">Pregúntale a mi IA</button>
  </div>
</section>

<footer class="footer">
  <div class="container wide inner">
    <span>Copyright © {year} {profile.name}. {profile.location}.</span>
    <span>Hecho con Astro · Asistente con Claude</span>
  </div>
</footer>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }
  .contact .headline {
    font-size: clamp(3rem, 9vw, 6rem);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 14px;
  }
  .ask {
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font);
    margin-top: 6px;
  }
  .footer {
    background: var(--bg-alt);
    color: var(--fg-3);
    font-size: 0.78rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 22px;
  }
</style>
